APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Contract addresses for /pixels, /predictions and /market default to the
# production deploys baked into the pages (see crypto/hardhat/deployments/).
# Set these only to point a build at a different deploy, then rebuild.
VITE_PIXEL_CONTRACT=
VITE_PREDICTIONS_CONTRACT=
VITE_NFT_CONTRACT=
VITE_NFT_MARKET=

PROXY_URL="http://127.0.0.1:2080"

# Comma-separated emails granted access to /admin/bridge-analytics
BRIDGE_ADMIN_EMAILS=

# When true, the / page renders the new wizard-style bridge UI. Use ?legacy=1
# to force the old UI per session.
BRIDGE_NEW_UX=true

# Bridge fee, denominated in USD. flat_usd is added on top of rate_bps * amount.
BRIDGE_FEE_FLAT_USD=0.10
BRIDGE_FEE_RATE_BPS=0
BRIDGE_NATIVE_TRANSFER_GAS_LIMIT=21000
BRIDGE_NATIVE_GAS_PRICE_FLOOR_GWEI=3
BRIDGE_NATIVE_GAS_MULTIPLIER_BPS=20000
# Flat YTN fee retained from evm_to_yenten payouts (covers the Yenten
# network fee so the recipient receives the displayed net amount exactly).
BRIDGE_YENTEN_PAYOUT_FEE_YTN=0.01

# Auto-drop a small amount of native CYBER to empty EVM destinations.
BRIDGE_GAS_DROP_ENABLED=true
BRIDGE_GAS_DROP_AMOUNT=0.01
BRIDGE_GAS_DROP_THRESHOLD_WEI=0

# Chain-level kill switches. Yenten/BTC/LTC/XMR are DISABLED by default: the
# chain disappears from the bridge and profile UIs and its routes reject
# quotes/submits. Flip to true once per-user deposit crediting runs unattended.
BRIDGE_CHAIN_YENTEN_ENABLED=false
BRIDGE_CHAIN_BTC_ENABLED=false
BRIDGE_CHAIN_LTC_ENABLED=false
BRIDGE_CHAIN_XMR_ENABLED=false

# Native Yenten light-wallet bridge. The DEPOSIT_ADDRESS/WIF are the central
# wallet: it receives swept deposits and pays out evm_to_yenten. The WIF signs
# locally and is never sent to api.yentencoin.info.
BRIDGE_YENTEN_DEPOSIT_ADDRESS=
BRIDGE_YENTEN_RELAYER_WIF=
BRIDGE_YENTEN_API_URL=https://api.yentencoin.info
# Claim/deposit detection checks these in order. explorer2 is first because it
# is the fresher Blockbook indexer; api.yentencoin.info remains a fallback.
BRIDGE_YENTEN_BALANCE_API_URLS=https://explorer2.yentencoin.info,https://api.yentencoin.info
BRIDGE_YENTEN_MIN_CONFIRMATIONS=1
# One-time deposit addresses stop being monitored after this many minutes.
BRIDGE_YENTEN_DEPOSIT_TTL_MINUTES=60
# Master seed (32-byte hex) for per-request one-time deposit addresses. Each
# yenten_to_evm request derives its own address so a public deposit tx cannot
# be hijacked. Generate: php -r 'echo bin2hex(random_bytes(32));'
BRIDGE_YENTEN_HD_SEED=

# Manual Bitcoin/Litecoin/Monero bridge corridors (hidden entirely while the
# BRIDGE_CHAIN_*_ENABLED switches above stay false).
# They stay unavailable for submit until a deposit/payout address is configured.
# Requests stay pending for operator review unless dedicated relayers are added.
# The per-chain HD seeds power personal (CEX-style) profile deposit addresses:
# BTC/LTC derive a P2PKH address per user (WIF re-derivable for sweeping via
# `php artisan bridge:user-deposit`); XMR derives an 8-byte payment id and
# issues an integrated address, so funds land directly in the main wallet
# (BRIDGE_XMR_DEPOSIT_ADDRESS must be a standard 4... address). Yenten's
# personal addresses reuse BRIDGE_YENTEN_HD_SEED under a separate namespace.
# Generate a seed: php -r 'echo bin2hex(random_bytes(32));'
BRIDGE_BTC_DEPOSIT_ADDRESS=
BRIDGE_BTC_HD_SEED=
BRIDGE_BTC_MIN_CONFIRMATIONS=3
BRIDGE_ROUTE_BTC_TO_EVM_ENABLED=true
BRIDGE_ROUTE_EVM_TO_BTC_ENABLED=true
BRIDGE_LTC_DEPOSIT_ADDRESS=
BRIDGE_LTC_HD_SEED=
BRIDGE_LTC_MIN_CONFIRMATIONS=6
BRIDGE_ROUTE_LTC_TO_EVM_ENABLED=true
BRIDGE_ROUTE_EVM_TO_LTC_ENABLED=true
BRIDGE_XMR_DEPOSIT_ADDRESS=
BRIDGE_XMR_HD_SEED=
BRIDGE_XMR_MIN_CONFIRMATIONS=10
BRIDGE_ROUTE_XMR_TO_EVM_ENABLED=true
BRIDGE_ROUTE_EVM_TO_XMR_ENABLED=true

# CyberiaProfile contract: on-chain nicknames + achievements shown on /profile.
# Deployed 2026-07-10 at 0xa9101ee859850c037b0867156b3535F78A387C0d (owner =
# relayer EOA) — that address is the config default, so leave this var out
# unless overriding after a redeploy (deploy-profile.ts) or hiding the section
# (set it explicitly empty).
# CYBERIA_PROFILE_ADDRESS=

# --- Slot machine ("одноручный бандит") ---
# Dedicated Solana hot wallet, completely separate from the bridge.
# Generate with: solana-keygen new -o ./storage/keys/slot-hot.json
SLOT_HOT_WALLET_ADDRESS=
SLOT_HOT_WALLET_KEYPAIR_PATH=
# Cluster: devnet | mainnet. Drives the default RPC for both server and
# browser sides. Use devnet while iterating — mainnet only when fully tested.
SLOT_CLUSTER=devnet
# Optional override. If empty, derived from SLOT_CLUSTER.
SLOT_RPC_URL=
SLOT_BURN_BPS=200
SLOT_HOUSE_EDGE_BPS=400
SLOT_JACKPOT_THRESHOLD_BPS=10
SLOT_MAX_SINGLE_WIN_BPS=2000
SLOT_MAX_BET_USD=50
# Refresh TTL for token metadata cache, hours.
SLOT_METADATA_TTL_HOURS=24
# Prepared spins expire after this many minutes if not confirmed.
SLOT_PREPARE_TTL_MINUTES=5

# --- Pump.fun auto-whitelist (Phase 2) ---
# Discovery uses pump.fun's public frontend API (no key required).
SLOT_PUMPFUN_API_BASE=https://frontend-api-v3.pump.fun
# Bulk import: hourly artisan command pulls top N by market cap >= min mcap.
SLOT_PUMPFUN_BULK_TOP_N=200
SLOT_PUMPFUN_MIN_MCAP_USD=10000
# Lazy auto-whitelist: when a user bets a mint not yet in the pool, verify it
# via pump.fun and add on the fly. Set false to require admin approval.
SLOT_PUMPFUN_LAZY_ENABLED=true
# When true, bulk + lazy imports set enabled=true (skip admin review) for
# tokens passing freeze-authority check.
SLOT_PUMPFUN_AUTO_ENABLE=true
# Web Push (browser notifications). Generate with: php artisan webpush:vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@cyberia.church

# --- Auth: X (Twitter) OAuth 2.0 ---
# App from developer.x.com; callback must be {APP_URL}/auth/twitter/callback.
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URI=/auth/twitter/callback

# --- Bridge: TON ---
# Operator TON wallet receiving native TON + jetton deposits (friendly EQ../UQ..
# or raw form). TON routes are hidden from the UI while unset. Use the wallet
# controlled by TON_RELAYER_MNEMONIC so one hot wallet serves both directions.
BRIDGE_TON_DEPOSIT_ADDRESS=
# 24-word mnemonic of the TON relayer wallet (v4R2) for automatic payouts.
TON_RELAYER_MNEMONIC=
# Optional tonapi.io bearer key (higher rate limits for deposit verification).
TONAPI_KEY=
BRIDGE_TON_API_URL=https://tonapi.io
BRIDGE_TONCENTER_RPC_URL=https://toncenter.com/api/v2/jsonRPC
TONCENTER_API_KEY=
# Flat TON retained from evm_to_ton native payouts (covers the TON message fee).
BRIDGE_TON_PAYOUT_FEE_TON=0.01

# --- Bridge: Cyberia (home chain) ---
# Backend/relayer RPC. In prod this may point at the internal node
# (e.g. http://polygon-edge:8545) for speed/reliability.
BRIDGE_EVM_RPC_URL=
CYBERIA_RPC_URL=https://rpc.cyberia.church
# Browser-facing RPC for client-side token-balance reads. MUST be publicly
# reachable, CORS-open and HTTPS — never the internal node URL, or source
# balances render blank in the bridge UI when sending from Cyberia.
BRIDGE_EVM_PUBLIC_RPC_URL=https://rpc.cyberia.church

# --- Bridge: BNB Chain ---
# Use a private RPC endpoint in production (public dataseed rate-limits).
BRIDGE_BSC_RPC_URL=https://bsc-dataseed.binance.org
# Cyberia wrapper for native BNB (deployed via scripts/deploy-bnb.ts). USDT on
# BNB uses the unified USDT wrapper — no separate contract. Routes stay hidden
# while unset.
BRIDGE_BNB_WRAPPER_ADDRESS=
# Open the BNB <-> Cyberia corridor once the wrapper above is set and the
# relayer holds BNB gas + USDT reserves on BSC for evm_to_bnb payouts.
BRIDGE_ROUTE_BNB_TO_EVM_ENABLED=false
BRIDGE_ROUTE_EVM_TO_BNB_ENABLED=false

# --- Bridge: Base ---
# Use a private RPC endpoint in production (the public one rate-limits).
BRIDGE_BASE_RPC_URL=https://mainnet.base.org
# ETH and USDC on Base use the unified ETH / USDC wrappers (pooled reserves,
# no per-chain contract). Open the corridor once the relayer holds ETH gas +
# USDC reserves on Base for evm_to_base payouts.
BRIDGE_ROUTE_BASE_TO_EVM_ENABLED=false
BRIDGE_ROUTE_EVM_TO_BASE_ENABLED=false

# --- Bridge: Robinhood Chain ---
# Arbitrum-stack L2 (chain id 4663), gas token ETH. Alchemy endpoints are the
# recommended private RPC if the public one rate-limits.
BRIDGE_ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Native ETH maps to the unified Cyberia ETH wrapper (pooled reserves, no
# per-chain contract). Open the corridor once the relayer holds ETH on
# Robinhood Chain for evm_to_robinhood payouts.
BRIDGE_ROUTE_ROBINHOOD_TO_EVM_ENABLED=false
BRIDGE_ROUTE_EVM_TO_ROBINHOOD_ENABLED=false

# --- Bridge: Solana ---
# Defaults to the Helius RPC baked into config/bridge.php; override here.
BRIDGE_SOLANA_RPC_URL=
BRIDGE_SOLANA_HOT_WALLET=E6E8AeKoT6i2zmwrGyDF2LwfEfjX9Xg8LfEj2Fu8Yf7w
