; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Wired"
config/description="A 3D on-chain game in the Cyberia ecosystem. NPCs think via LainOS; the world reacts to the Cyberia chain."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Chain="*res://scripts/autoload/Chain.gd"
LainAgent="*res://scripts/autoload/LainAgent.gd"
Wallet="*res://scripts/autoload/Wallet.gd"
Nft="*res://scripts/autoload/Nft.gd"
WiredAuth="*res://scripts/autoload/WiredAuth.gd"
Forge="*res://scripts/autoload/Forge.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
