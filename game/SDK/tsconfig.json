{
  "compilerOptions": {
    "lib": ["ES2023"],
    "module": "Node20",
    "moduleResolution": "Node16",
    "target": "ES2023",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "verbatimModuleSyntax": true
  },
  "include": ["hardhat.config.ts", "scripts/**/*.ts", "test/**/*.ts"]
}
