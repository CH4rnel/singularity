#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/home/CH4rnel_exe/Projects/singularity/game/SDK/node_modules/.pnpm/hardhat@3.12.0/node_modules/hardhat/node_modules:/home/CH4rnel_exe/Projects/singularity/game/SDK/node_modules/.pnpm/hardhat@3.12.0/node_modules:/home/CH4rnel_exe/Projects/singularity/game/SDK/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/home/CH4rnel_exe/Projects/singularity/game/SDK/node_modules/.pnpm/hardhat@3.12.0/node_modules/hardhat/node_modules:/home/CH4rnel_exe/Projects/singularity/game/SDK/node_modules/.pnpm/hardhat@3.12.0/node_modules:/home/CH4rnel_exe/Projects/singularity/game/SDK/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../.pnpm/hardhat@3.12.0/node_modules/hardhat/dist/src/cli.js" "$@"
else
  exec node  "$basedir/../.pnpm/hardhat@3.12.0/node_modules/hardhat/dist/src/cli.js" "$@"
fi
