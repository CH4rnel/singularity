+        async function disconnectHandler() {
+            // Cyberia mints a block every ~1s, so MetaMask routinely emits a
+            // transient EIP-1193 'disconnect' on a brief RPC hiccup while the
+            // wallet is still connected. eth_accounts is answered locally by
+            // MetaMask (it does not hit the chain RPC), so a still-permitted
+            // account survives a network blip. Only tear the session down when
+            // there are genuinely no accounts left.
+            try {
+                const accounts = await InjectedProvider?.request({ method: 'eth_accounts' });
+                if (accounts && accounts.length > 0) {
+                    return;
+                }
+            }
+            catch { }
             localStorage.removeItem(EthersConstantsUtil.WALLET_ID);
             EthersStoreUtil.reset();
