# --- Cyberia network (public defaults) ---
REACT_APP_CHAIN_ID=49406
REACT_APP_NETWORK_URL=https://rpc.cyberia.church

# Build workaround: treat TS type errors as warnings so the build does not fail
# on type-only noise from node_modules (viem/ox/abitype). Runtime is unaffected.
TSC_COMPILE_ON_ERROR=true

