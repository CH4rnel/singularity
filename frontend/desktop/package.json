{
    "name": "cyberia-desktop",
    "version": "1.2.0",
    "private": true,
    "description": "Cyberia desktop wallet with a bundled local interface",
    "homepage": "https://cyberia.church",
    "author": "Cyberia <noreply@cyberia.church>",
    "desktopName": "Cyberia.desktop",
    "license": "MIT",
    "type": "commonjs",
    "main": "src/main.js",
    "scripts": {
        "start": "electron .",
        "build:renderer": "node scripts/build-renderer.mjs",
        "sign:release": "node scripts/sign-release.mjs",
        "prestart": "npm run build:renderer",
        "test": "node --test test/*.test.js",
        "test:renderer": "electron scripts/check-renderer.cjs",
        "test:package": "node scripts/check-package.mjs",
        "dist": "electron-builder",
        "predist": "npm run build:renderer",
        "dist:linux": "electron-builder --linux",
        "predist:linux": "npm run build:renderer",
        "dist:win": "electron-builder --win",
        "predist:win": "npm run build:renderer",
        "dist:mac": "electron-builder --mac",
        "predist:mac": "npm run build:renderer",
        "prepack": "npm run build:renderer",
        "pack": "electron-builder --dir"
    },
    "devDependencies": {
        "electron": "^43.2.0",
        "electron-builder": "^26.15.3"
    },
    "dependencies": {
        "webtorrent": "^3.0.21"
    }
}
