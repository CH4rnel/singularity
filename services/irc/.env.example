# Copy to .env (gitignored) and fill in. Single quotes matter: a bcrypt hash
# is full of `$`, and compose would otherwise try to interpolate it.
#
# Generate the hash with:
#   docker run --rm -i --entrypoint /ircd-bin/ergo ghcr.io/ergochat/ergo:v2.19.1 genpasswd
# then log in on IRC with: /OPER admin <password>
ERGO__OPERS__ADMIN__PASSWORD='$2a$04$...'

# Where the Let's Encrypt store lives on the host (default /root/certbot/conf).
# IRC_TLS_DIR=/root/certbot/conf

# lain-bot. The password is the IRC account `lain` (registered by the bot on its
# first connect, SASL afterwards); the token must equal IRC_LAIN_TOKEN in the
# Laravel .env, or /api/irc/lain answers 404.
IRC_LAIN_PASSWORD=
IRC_LAIN_TOKEN=
# IRC_LAIN_CHANNELS=#cyberia
