# Cyberia Telegram airdrop bot — environment.
# Copy to .env and fill in. Never commit the real .env (see .gitignore).
# Override the file location with BOT_ENV_FILE if you keep it elsewhere.

# --- Required to run the bot ---
TELEGRAM_BOT_TOKEN=
# Deployer key used for on-chain mints (chat tokens, reward payouts, claims).
# NEVER commit or log this value.
DEPLOYER_PK=

# --- Optional ---
TELEGRAM_CHAT_ID=
# http:// or socks5:// proxy for the Telegram API (blank = direct).
HTTP_PROXY=
# Shared Laravel SQLite DB. On prod this points at the live database.sqlite.
DB_PATH=
# Factory used by /create_token (per-chat reward tokens).
TELEGRAM_TOKEN_FACTORY=

# --- Chain (defaults are Cyberia mainnet; override only to point elsewhere) ---
# RPC_URL=https://rpc.cyberia.church
# CHAIN_ID=49406
# EXPLORER_URL=https://explorer.cyberia.church

# --- Announcers (all default to @cyberia_network_chat) ---
# BRIDGE_ANNOUNCE_CHAT=@cyberia_network_chat
# Lending supply/withdraw/borrow/repay announcer. Same address the DEX frontend
# reads as VITE_LENDING_COMPTROLLER. Leave empty to disable the lending announcer.
LENDING_COMPTROLLER=

# --- Whales chat gate ---
# Numeric chat id of the whales supergroup (looks like -1002688848155, NOT
# 2688848155). The bot must be an admin there with "Invite Users via Link".
# Leave empty to disable the whale gate entirely.
WHALE_CHAT_ID=

# --- Logging (optional) ---
# Default log file is services/telegram-bot/bot.log; override here if ops watch
# a different path (logs always also go to stdout).
# BOT_LOG_FILE=
