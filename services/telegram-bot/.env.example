# Cyberia Telegram airdrop bot — environment.
# Copy to .env and fill in. Never commit the real .env (see .gitignore).
# Override the file location with BOT_ENV_FILE if you keep it elsewhere.

# --- Required to run the bot ---
TELEGRAM_BOT_TOKEN=
# Deployer key used for on-chain mints (chat tokens, reward payouts, claims).
# NEVER commit or log this value.
DEPLOYER_PK=

# --- Optional ---
TELEGRAM_CHAT_ID=
# http:// or socks5:// proxy for the Telegram API (blank = direct).
HTTP_PROXY=
# Shared Laravel SQLite DB. On prod this points at the live database.sqlite.
DB_PATH=
# Factory used by /create_token (per-chat reward tokens).
TELEGRAM_TOKEN_FACTORY=

# --- AI assistant (OpenAI-compatible chat completions API) ---
# Leave AI_API_KEY empty to disable. The assistant answers normal text in DMs;
# in groups it answers /ask, @bot mentions, and replies to the bot.
AI_API_KEY=
# OPENAI_API_KEY is also accepted when AI_API_KEY is unset.
# If both are empty, the monorepo deployment automatically reuses
# ../lainos/.env's OPENROUTER_API_KEY and OPENROUTER_MODEL_SMALL.
# AI_API_URL=https://api.openai.com/v1/chat/completions
# AI_MODEL=gpt-4.1-mini
# AI_TIMEOUT_SECONDS=45
# AI_MAX_OUTPUT_TOKENS=700
# Number of prior user/assistant messages retained per user and chat.
# AI_HISTORY_MESSAGES=8
# Per-user spam/cost controls.
# AI_USER_COOLDOWN_SECONDS=3
# AI_MAX_CONCURRENT_REQUESTS=3
# AI_MAX_QUESTION_CHARS=4000

# --- Chain (defaults are Cyberia mainnet; override only to point elsewhere) ---
# RPC_URL=https://rpc.cyberia.church
# CHAIN_ID=49406
# EXPLORER_URL=https://explorer.cyberia.church

# --- Announcers (all default to @cyberia_network_chat) ---
# BRIDGE_ANNOUNCE_CHAT=@cyberia_network_chat
# Lending supply/withdraw/borrow/repay announcer. Same address the DEX frontend
# reads as VITE_LENDING_COMPTROLLER. Leave empty to disable the lending announcer.
LENDING_COMPTROLLER=
# CyberSolSwap redeemer that converts bridged CYBER.sol -> native CYBER (1000:1).
# Defaults to the live deployment; set empty to disable the conversion announcer.
# CYBERSOL_SWAP_ADDRESS=0x69b1614B088F5670E49bcC6fE33F28F2544F7415

# --- Whales chat gate ---
# Numeric chat id of the whales supergroup (looks like -1002688848155, NOT
# 2688848155). The bot must be an admin there with "Invite Users via Link".
# Leave empty to disable the whale gate entirely.
WHALE_CHAT_ID=

# --- NFT from channel posts ---
# When the bot is an admin of a PUBLIC channel, each new post is minted into the
# shared CyberiaNFT collection (ERC-721 + IPFS metadata) and shows on the NFT
# marketplace. Needs DEPLOYER_PK (signs the mint) and a reachable Kubo node.
# Set NFT_FROM_POSTS=0 to disable.
NFT_FROM_POSTS=1
# Pin metadata to IPFS but skip the on-chain mint (no gas) — for testing.
NFT_FROM_POSTS_DRYRUN=0
# CyberiaNFT collection (default is the live deployment).
# CYBERIA_NFT_ADDRESS=0x546462FAbf30734E63b64f32B30EC8ADD9B6EBa7
# Local Kubo HTTP API for pinning images + metadata.
IPFS_API_URL=http://127.0.0.1:5001

# --- Logging (optional) ---
# Default log file is services/telegram-bot/bot.log; override here if ops watch
# a different path (logs always also go to stdout).
# BOT_LOG_FILE=
