# VitePress builds the documentation into the repository on every production
# deploy. This exact hostname wins over the launchpad regex server; without it,
# docs.cyberia.church is interpreted as a token-site slug and Laravel returns
# 404.
server {
    listen 80;
    server_name docs.cyberia.church;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://docs.cyberia.church$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name docs.cyberia.church;

    # docs.cyberia.church resolves through the wildcard DNS record, and the
    # launchpad wildcard certificate covers this exact hostname too.
    ssl_certificate /etc/letsencrypt/live/cyberia-wildcard/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/cyberia-wildcard/privkey.pem;

    root /usr/share/nginx/docs;
    index index.html;
    charset utf-8;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # VitePress fingerprints everything in /assets, so those files can be
    # cached forever. HTML stays revalidatable and picks up a new deployment.
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
    }

    location / {
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        try_files $uri $uri.html $uri/index.html =404;
    }

    error_page 404 /404.html;
}
