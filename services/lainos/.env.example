# LainOS environment. Copy to .env and fill in. Never commit .env.

# --- Model provider ---
# Provider selection order:
#   1. LAINOS_MODEL_PROVIDER (cyberia | codex | claude | opencode | openrouter | anthropic | mock), if set
#   2. CYBERIA_AI_KEY present     -> cyberia (free)
#   3. OPENROUTER_API_KEY present -> openrouter
#   4. ANTHROPIC_API_KEY present  -> anthropic
#   5. claude CLI on the machine  -> claude (subscription, no key)
#   6. otherwise                  -> offline mock
# Leave this blank to auto-select by which key is present.
LAINOS_MODEL_PROVIDER=
# Optional HTTP(S) proxy for model API traffic only (OpenRouter/Anthropic/CLIs),
# for hosts where those endpoints are blocked. Falls back to HTTPS_PROXY.
# Chain RPC traffic is never proxied.
LAINOS_MODEL_PROXY=
# Per-tier routing on top of the base provider: route one capability tier
# (small | medium | large) to a different provider, e.g.
#   LAINOS_MODEL_TIER_MEDIUM=openrouter
# Leave all empty to run every tier on the base provider.
LAINOS_MODEL_TIER_SMALL=
LAINOS_MODEL_TIER_MEDIUM=
LAINOS_MODEL_TIER_LARGE=
# Cross-provider fallback (opt-in): retry a failed call on this provider
# (cyberia | openrouter | anthropic | claude | codex | opencode). Empty = fail loudly
# instead of silently answering with a model you didn't choose.
LAINOS_MODEL_FALLBACK=

# --- Task routing (who answers which kind of work) ---
# Every turn is classified by what it *is* — 💬 chat, 🛠 code, 💰 money,
# ✍️ write, 📊 analysis, 📰 digest, 🌐 translate, 🧠 memory — and routed by
# that, so summarising an RSS feed never costs what a trade is worth. Each
# route is provider[:model]; the model may carry colons of its own.
#   LAINOS_TASK_DIGEST=openrouter:openai/gpt-oss-120b:free
#   LAINOS_TASK_CHAT=claude
LAINOS_TASK_CHAT=
LAINOS_TASK_CODE=
LAINOS_TASK_MONEY=
LAINOS_TASK_WRITE=
LAINOS_TASK_ANALYSIS=
LAINOS_TASK_DIGEST=
LAINOS_TASK_TRANSLATE=
LAINOS_TASK_MEMORY=
# One knob for all the cheap kinds (digest, translate, analysis, memory) that
# have no route of their own. Left empty, LainOS adopts a free route this
# machine already has — a Cyberia grant, else OpenRouter's free router — and
# says so at boot. `none` keeps every kind on the one provider.
LAINOS_TASK_CHEAP=
# Model the automatic OpenRouter cheap route pins (default openrouter/free).
OPENROUTER_MODEL_CHEAP=
# A cheap turn that reaches for a tool is lifted back onto the main provider
# (reading a balance or writing a file is not text drudgery). =0 to disable.
LAINOS_TASK_ESCALATE=

# --- Sessions ---
# Every surface leaves a session behind (data/sessions.json): /new starts one,
# /resume reopens one, /recap sums one up. This caps how many are *indexed* —
# the messages themselves live in memory.json and are never trimmed by it.
LAINOS_SESSION_LIMIT=300

# --- Cyberia (free; OpenAI-compatible) ---
# Ask an operator to issue a LainOS key at https://cyberia.church/crm/api-keys,
# then copy the two-line setup shown there. Cyberia is auto-selected whenever
# this key exists, or select it explicitly with /model cyberia.
CYBERIA_AI_KEY=
CYBERIA_AI_BASE_URL=https://cyberia.church/api/ai/v1
CYBERIA_AI_MODEL_SMALL=lain-free
CYBERIA_AI_MODEL_MEDIUM=lain-free
CYBERIA_AI_MODEL_LARGE=lain-free

# --- OpenRouter (one key, many models; OpenAI-compatible) ---
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# `openrouter/free` is OpenRouter's $0 "Free Models Router": it auto-routes to an
# available free model and keeps tool calling working (needed for Lain's on-chain
# actions). One slug, no rate-limit babysitting; quality varies per request.
OPENROUTER_MODEL_SMALL=openrouter/free
OPENROUTER_MODEL_MEDIUM=openrouter/free
OPENROUTER_MODEL_LARGE=openrouter/free
# To pin a specific free model instead:
#   OPENROUTER_MODEL_LARGE=openai/gpt-oss-120b:free
# For best quality (paid), use Claude:
#   OPENROUTER_MODEL_LARGE=anthropic/claude-opus-4.8
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_REFERER=https://cyberia.church
# OPENROUTER_TITLE=LainOS

# --- Codex CLI (ChatGPT subscription; no API key) ---
# LAINOS_MODEL_PROVIDER=codex runs each completion through one `codex exec`
# run billed to the machine's ChatGPT login (`codex login`). Replies arrive
# whole (no streaming). A failed run is retried in-house (see
# LAINOS_CODEX_RETRIES); it never falls back to another provider unless
# LAINOS_MODEL_FALLBACK explicitly names one.
# Binary autodetected (PATH, then ~/.local/bin/codex); override:
LAINOS_CODEX_BIN=
# Model per tier; empty = the CLI's configured default model.
LAINOS_CODEX_MODEL_SMALL=
LAINOS_CODEX_MODEL_MEDIUM=
LAINOS_CODEX_MODEL_LARGE=
# Hard timeout for one completion, ms. Default 240000 (4 min).
LAINOS_CODEX_TIMEOUT_MS=
# Extra attempts after a failed run (transient blips; timeouts are never
# retried). Default 1; 0 disables.
LAINOS_CODEX_RETRIES=
# Extra args appended to `codex exec`, e.g. for snappier chat replies:
#   LAINOS_CODEX_ARGS=-c model_reasoning_effort="low"
LAINOS_CODEX_ARGS=
# Codex runs read-only-sandboxed in an empty scratch dir (default
# $LAINOS_DATA_DIR/codex — never the repo). Override:
LAINOS_CODEX_CWD=

# --- Claude CLI (Claude subscription; no API key) ---
# LAINOS_MODEL_PROVIDER=claude runs each completion through one
# `claude --print` run billed to the machine's Claude login (`claude` →
# /login). The coding agent is fenced down to a chat: no built-in tools
# (--tools ""), no CLAUDE.md/skills/hooks/MCP (--safe-mode), scratch cwd.
# Same models as the ANTHROPIC_API_KEY route below, other billing; whichever
# of the two is configured answers when you ask Lain to switch to Claude.
# Binary autodetected (PATH, then ~/.local/bin/claude); override:
LAINOS_CLAUDE_BIN=
# Model per tier; empty = the alias defaults (haiku / sonnet / opus), which
# always resolve to the latest snapshot of that model.
LAINOS_CLAUDE_MODEL_SMALL=
LAINOS_CLAUDE_MODEL_MEDIUM=
LAINOS_CLAUDE_MODEL_LARGE=
# Hard timeout for one completion, ms. Default 240000 (4 min).
LAINOS_CLAUDE_TIMEOUT_MS=
# Extra attempts after a failed run (transient blips; timeouts are never
# retried). Default 1; 0 disables.
LAINOS_CLAUDE_RETRIES=
# Extra args appended to the `claude` invocation, e.g.:
#   LAINOS_CLAUDE_ARGS=--effort low
LAINOS_CLAUDE_ARGS=
# Scratch working directory (default $LAINOS_DATA_DIR/claude — never the repo):
LAINOS_CLAUDE_CWD=

# --- OpenCode CLI (agent runner; your own OpenCode setup, no LainOS key) ---
# LAINOS_MODEL_PROVIDER=opencode runs each completion through one
# `opencode run` invocation using the machine's OpenCode config — providers,
# models and auth all live in OpenCode (`opencode` -> /login). Native OpenCode
# tools are disabled for the run, so it behaves as a plain chat model; LainOS
# tools travel over the same JSON-in-the-reply protocol as codex/claude.
# A failed run is retried in-house (see LAINOS_OPENCODE_RETRIES); it never
# falls back to another provider unless LAINOS_MODEL_FALLBACK names one.
# Binary autodetected (PATH, then ~/.local/bin, then ~/.opencode/bin); override:
LAINOS_OPENCODE_BIN=
# Model per tier (`provider/model`, e.g. anthropic/claude-opus-4-8); empty =
# OpenCode's configured default model.
LAINOS_OPENCODE_MODEL_SMALL=
LAINOS_OPENCODE_MODEL_MEDIUM=
LAINOS_OPENCODE_MODEL_LARGE=
# Hard timeout for one completion, ms. Default 240000 (4 min).
LAINOS_OPENCODE_TIMEOUT_MS=
# Extra attempts after a failed run (transient blips; timeouts are never
# retried). Default 1; 0 disables.
LAINOS_OPENCODE_RETRIES=
# Extra args appended to `opencode run`, e.g.:
#   LAINOS_OPENCODE_ARGS=--agent plan
LAINOS_OPENCODE_ARGS=
# Scratch working directory (default $LAINOS_DATA_DIR/opencode — never the repo):
LAINOS_OPENCODE_CWD=

# --- Model transcripts ---
# Every LainOS turn writes the model request/response, tool calls and tool
# results to $LAINOS_DATA_DIR/model-transcripts for debugging why a task did or
# did not use tools. Set to 0 to disable. Secrets are redacted before writing.
LAINOS_MODEL_TRANSCRIPTS=1
LAINOS_MODEL_TRANSCRIPTS_DIR=

# --- Anthropic (direct API key) ---
# Same models as the Claude CLI above, billed per token instead of by
# subscription. With neither a key nor any CLI, LainOS falls back to a
# deterministic mock model so the runtime loop is still demonstrable offline.
ANTHROPIC_API_KEY=
LAINOS_MODEL_SMALL=claude-haiku-4-5-20251001
LAINOS_MODEL_MEDIUM=claude-sonnet-4-6
LAINOS_MODEL_LARGE=claude-opus-4-8

# --- Cyberia chain plugin (defaults are Cyberia mainnet) ---
CYBERIA_RPC_URL=https://rpc.cyberia.church
CYBERIA_CHAIN_ID=49406
# Optional: a 0x private key enables the `send_cyber` / token-transfer actions.
# Leave empty for read-only mode. Also required for `buy_token` Ritual swaps.
# Never commit a real key.
CYBERIA_AGENT_PK=
# Autonomous speculative buys ("купи LAIN" with no amount) use these hard risk
# limits. Spend = min(wallet after gas reserve * fraction, maxCyber, pool side
# * poolFraction), then refuse if price impact is too high.
LAINOS_SPECULATE_GAS_RESERVE_CYBER=0.02
LAINOS_SPECULATE_MAX_CYBER=0.05
LAINOS_SPECULATE_MIN_CYBER=0.001
LAINOS_SPECULATE_WALLET_FRACTION_BPS=500
LAINOS_SPECULATE_POOL_FRACTION_BPS=50
LAINOS_SPECULATE_MAX_IMPACT_BPS=150
LAINOS_SPECULATE_SLIPPAGE_BPS=100
LAINOS_SPECULATE_DEADLINE_SECONDS=300
# Autonomous basket buys ("потрать 0.90 CYBER, купи несколько токенов").
# Empty = scan all live WCYBER pairs on the Ritual factory. Set a comma list
# only when you intentionally want to constrain the universe.
LAINOS_BASKET_TOKENS=
LAINOS_BASKET_MAX_PAIR_SCAN=500
LAINOS_BASKET_MAX_TOKENS=4
LAINOS_BASKET_MIN_TRADE_CYBER=0.01
LAINOS_BASKET_POOL_FRACTION_BPS=150
LAINOS_BASKET_MAX_IMPACT_BPS=500
LAINOS_BASKET_SLIPPAGE_BPS=100
LAINOS_BASKET_DEADLINE_SECONDS=300

# --- HTTP client (used by the Wired game's NPCs) ---
LAINOS_HTTP_HOST=127.0.0.1
LAINOS_HTTP_PORT=7777

# --- Telegram bot (optional; started by `npm run serve` when the token is set) ---
# Create a bot with @BotFather and paste its token here. Never commit it.
TELEGRAM_BOT_TOKEN=
# Comma-separated chat-id allowlist. Empty = anyone may talk to the agent.
# Strongly recommended when CYBERIA_AGENT_PK is configured (the bot can send).
TELEGRAM_ALLOWED_CHATS=
# Comma-separated sender allowlist: usernames (with or without @) or numeric
# user ids. Empty = everyone. Example: TELEGRAM_ALLOWED_USERS=rtutin
TELEGRAM_ALLOWED_USERS=
# Optional HTTP(S) proxy for Telegram API traffic only, for hosts where
# api.telegram.org is blocked (e.g. http://127.0.0.1:10808). Falls back to
# HTTPS_PROXY/https_proxy. Chain RPC traffic is never proxied.
TELEGRAM_PROXY=
# Chat id for the send_telegram action — Lain's operator notification channel,
# available in TUI, HTTP, and daemon mode. Empty: falls back to the
# first TELEGRAM_ALLOWED_CHATS entry, then to the single known private chat
# in data/telegram.json.
TELEGRAM_OPERATOR_CHAT_ID=
# Every reply carries a provenance footer with the model that produced it
# (e.g. "⌁ codex/gpt-5.5") so the operator can see it's the subscription
# answering, not a fallback. Set 0 to hide.
LAINOS_REPLY_SIGNATURE=1

# --- Sentinel (background balance watches -> alerts) ---
# Poll cadence for watches, in milliseconds (min 5000). Watches persist in
# data/sentinel.json; alerts push to Telegram/TUI or surface in the next chat.
LAINOS_SENTINEL_INTERVAL_MS=60000

# --- Forge (holder wishes -> code, via coding agents) ---
# Lain logs holder wishes (log_wish) and forges them into the current branch of
# the singularity repo by driving a coding agent. Detection order: claude, codex,
# opencode. Use LAINOS_FORGE_AGENT=claude|codex|opencode as the initial
# provider; live changes are made with set_forge_provider and persist in
# data/forge.json.
LAINOS_FORGE_AGENT=
# Model passed to the forge coding-agent CLI. For Claude this becomes
# `claude --model <value>`; for Codex `codex exec -m <value>`; for OpenCode
# `opencode run -m <value>`. Provider-specific settings override the shared one.
LAINOS_FORGE_MODEL=
LAINOS_FORGE_CLAUDE_MODEL=
LAINOS_FORGE_CODEX_MODEL=
LAINOS_FORGE_OPENCODE_MODEL=
# Repo the agents work on. Default: the git root above the daemon's cwd.
LAINOS_FORGE_REPO=
# Dangerous self-upgrade mode. Set 1 only on a trusted host/repo clone:
# Codex runs with --dangerously-bypass-approvals-and-sandbox, Claude runs with
# --dangerously-skip-permissions, OpenCode with --auto. Leave 0/empty to keep
# Codex workspace-sandboxed, Claude on acceptEdits, OpenCode on the host's
# normal permissions (unanswerable asks are denied).
LAINOS_FORGE_YOLO=0
# Auto mode: when idle, pick the oldest open wish and forge it. On by default;
# set 0 to only build on request (build_wish).
LAINOS_FORGE_AUTO=1
# How often auto mode looks for work, ms (min 60000). Default 30 min.
LAINOS_FORGE_AUTO_INTERVAL_MS=1800000
# Hard kill for one job, ms. Default 40 min.
LAINOS_FORGE_TIMEOUT_MS=2400000
# A job that fails faster than this (agent died at startup: auth/subscription/
# quota) is retried once on the other installed CLI. Default 3 min; 0 disables.
LAINOS_FORGE_FALLBACK_MS=180000
# Proxy for the coding agents' API traffic; falls back to LAINOS_MODEL_PROXY.
LAINOS_FORGE_PROXY=
# Extra CLI args appended to the agent invocation.
LAINOS_FORGE_CLAUDE_ARGS=
LAINOS_FORGE_CODEX_ARGS=
LAINOS_FORGE_OPENCODE_ARGS=
# Extra lines appended to every job prompt (project-specific instructions).
LAINOS_FORGE_PROMPT_EXTRA=
# Test hook: replace the agent with a shell command (gets LAINOS_FORGE_PROMPT).
LAINOS_FORGE_CMD=

# --- Scout (autonomous researcher: topics -> scheduled digests) ---
# "следи за Solana", "каждый день собирай всё про zkVM" -> a topic swept over
# Hacker News, Reddit, GitHub and Google News; the model distills a digest and
# stays silent when nothing matters. Topics persist in data/scout.json.
# How often the scheduler checks for due topics, ms (min 60000).
LAINOS_SCOUT_INTERVAL_MS=600000
# Proxy for source/API traffic; falls back to LAINOS_MODEL_PROXY.
LAINOS_SCOUT_PROXY=
# Optional Nitter instance for X/Twitter search RSS (e.g. https://nitter.net).
LAINOS_SCOUT_NITTER=
# Optional GitHub token to lift the 10 req/min unauthenticated search limit.
GITHUB_TOKEN=
# Lain's first standing goal: study Cyberia and report concrete findings in
# Telegram. Set 0 to disable. If no chat id is set here, the daemon uses the
# first TELEGRAM_ALLOWED_CHATS entry, then falls back to known Telegram chats.
LAINOS_CYBERIA_STUDY=1
LAINOS_CYBERIA_STUDY_CHAT_ID=
LAINOS_CYBERIA_STUDY_INTERVAL_HOURS=1

# --- GitHub streak keeper (daily "you haven't committed yet" reminders) ---
# "напоминай мне каждый день, если я не сделал ни одного коммита" -> a watch on
# the account's public contribution graph; one evening reminder per commitless
# day, silence otherwise. Watches persist in data/github.json.
# How often the watcher checks due watches, ms (min 60000). Default 30 min.
LAINOS_GITHUB_INTERVAL_MS=1800000
# Default host-local hour (0-23) after which a commitless day is nudged.
LAINOS_GITHUB_REMIND_HOUR=18
# Proxy for github.com traffic; falls back to LAINOS_SCOUT_PROXY, then
# LAINOS_MODEL_PROXY / HTTPS_PROXY.
LAINOS_GITHUB_PROXY=

# --- Room keeper (daily "it's quiet in here" reminders) ---
# "следи, чтобы в канале каждый день были посты" -> a watch on the channel's
# public web preview (t.me/s/<name>, no admin rights needed); one evening
# reminder per postless day, silence otherwise. The channel's posts mirror to
# Twitter, which moves CYBER.sol — hence the nagging.
# Rooms nothing can read from outside (a Discord behind an invite, a group chat
# in X) are watched too, but on schedule alone: the nudge says it did not look,
# and "я уже написал туда" silences it for the day. All due rooms arrive as one
# evening message per chat. Persists in data/channels.json.
# How often the watcher checks due watches, ms (min 60000). Default 30 min.
LAINOS_CHANNEL_INTERVAL_MS=1800000
# Default host-local hour (0-23) after which a silent day is nudged.
LAINOS_CHANNEL_REMIND_HOUR=18
# Proxy for t.me traffic; falls back to TELEGRAM_PROXY, then LAINOS_MODEL_PROXY
# / HTTPS_PROXY (t.me is blocked on the same hosts as api.telegram.org).
LAINOS_CHANNEL_PROXY=

# --- Wired game-auth server (model B: signs WiredForge entry tickets) ---
# Tickets are signed with CYBERIA_AGENT_PK (above). Its address MUST equal
# WiredForge.signer() on-chain (currently the deployer 0xfA41…5179) — otherwise
# the contract rejects the tickets. Change it with setSigner() if you use a
# dedicated signer key here.
WIRED_FORGE_ADDRESS=0x2daa4A79EC2224AD02D9D4eBf937924b76F669Fa
WIRED_CHAIN_ID=49406
WIRED_HTTP_PORT=7788

# Where long-term memory is persisted (memory.json: conversation + durable facts).
LAINOS_DATA_DIR=./data

# The agent's soul: a markdown constitution prepended verbatim to the system
# prompt. Default lookup is soul.md at the package root; override the path here.
# Loaded once at boot — restart the daemon after editing it.
# LAINOS_SOUL_PATH=./soul.md

# --- Semantic memory (optional) ---
# By default memory retrieval is keyword + recency. Wire up an embedding model
# to retrieve by *meaning* instead (cosine similarity). Vectors are cached in
# data/embeddings.json. Selection order:
#   1. LAINOS_EMBED_PROVIDER (openai | hash | none), if set
#   2. LAINOS_EMBED_API_KEY / OPENAI_API_KEY, or LAINOS_EMBED_BASE_URL present
#      -> OpenAI-compatible /embeddings endpoint (true semantic recall)
#   3. otherwise -> keyword retrieval (no embeddings, no network)
# `hash` is a zero-config, offline, dependency-free fallback: lexical vectors,
# not real semantics, but the same code path (so adding a key later just works).
LAINOS_EMBED_PROVIDER=
# OpenAI-compatible endpoint. Leave the API key blank for a local server that
# needs no auth. Examples:
#   OpenAI : LAINOS_EMBED_API_KEY=sk-...      LAINOS_EMBED_MODEL=text-embedding-3-small
#   Ollama : LAINOS_EMBED_BASE_URL=http://localhost:11434/v1  LAINOS_EMBED_MODEL=nomic-embed-text
LAINOS_EMBED_API_KEY=
# LAINOS_EMBED_BASE_URL=https://api.openai.com/v1
# LAINOS_EMBED_MODEL=text-embedding-3-small
# Optional: shrink vectors (OpenAI v3 models) / set the hash embedder's size.
# LAINOS_EMBED_DIMENSIONS=512
# NOTE: stored vectors are only comparable within one model. If you change
# LAINOS_EMBED_MODEL, delete data/embeddings.json so they get re-embedded.

# --- System plugin (terminal + filesystem skills) ---
# Loaded only for characters that request the "system" plugin. Gives the agent
# run_shell / read_file / write_file / list_dir, all confined to the workspace
# below. This is a powerful, dual-use capability — scope LAINOS_WORKSPACE to a
# directory you are comfortable letting the agent read and modify.
# Default (when unset): ./workspace under the daemon's cwd — never the cwd
# itself, so the agent cannot read .env or litter the repo it runs from.
LAINOS_WORKSPACE=./workspace
# Hard timeout for a single shell command, in milliseconds.
LAINOS_SHELL_TIMEOUT_MS=30000

# --- Skills (instant self-extension) ---
# Hot-loaded skill modules: skills/*.mjs, each default-exporting one tool
# ({ name, description, parameters, handler }). Lain writes them herself with
# create_skill and they become live tools seconds later — no restart. The
# directory is watched; the forge and the operator may drop skills in too.
# Skills are part of the repo: her learning gets committed like any code.
LAINOS_SKILLS_DIR=./skills
# android_apk (skills/android_apk.mjs) builds frontend/mobile and sends the APK
# to the operator as a Telegram document. It needs the monorepo, which it finds
# through the forge repo or its own location; override only if those are wrong.
LAINOS_APK_REPO=
# owner/repo for the GitHub Actions fallback. Default: the repo's origin remote.
# Downloading a CI artifact needs GITHUB_TOKEN above (scope actions:read).
LAINOS_APK_GITHUB_REPO=
# Hard timeout for one gradle build, ms. Default 25 min.
LAINOS_APK_TIMEOUT_MS=1500000

# --- Initiative (she writes first) ---
# The daemon gives Lain a jittered heartbeat: a private tick where she reviews
# watches, trades, research and the conversation, then either messages the
# operator on Telegram or stays silent (NOTHING). Daemon-only by default;
# LAINOS_INITIATIVE=1 forces it elsewhere, =0 disables it entirely.
LAINOS_INITIATIVE=
# Mean interval between ticks (±25% jitter). Default 3h.
LAINOS_INITIATIVE_INTERVAL_MS=10800000
# Local quiet hours "start-end" (may wrap midnight); no self-started messages
# inside the window. Night alerts remain the sentinel's job. "0-0" disables.
LAINOS_INITIATIVE_QUIET=23-9
# Hard cap of self-started messages per day.
LAINOS_INITIATIVE_MAX_PER_DAY=6

# --- Study (autonomous self-teaching over her own monorepo) ---
# On a slow schedule Lain analyses one repo area read-only (git history, tracked
# source, TODO/FIXME markers), researches how others solve the same problem via
# the scout's sources, and messages the operator only when she has a concrete,
# grounded, non-repeating finding. She never edits, forges, or logs a wish from
# this loop. Daemon-only by default; LAINOS_STUDY=1 forces it, =0 disables it.
LAINOS_STUDY=
# Hours between lessons. Default 6.
LAINOS_STUDY_INTERVAL_HOURS=6
# Repo areas to rotate through (comma-separated, repo-relative). Empty = the
# built-in list (lainos, laravel, ritual, hardhat, anchor, tg-bot, nocarrier, scripts).
LAINOS_STUDY_AREAS=
# Repository to study. Defaults to the forge's repo, else the enclosing git root.
LAINOS_STUDY_REPO=
# Set 0 to study the code only, without the scout's external sweep.
LAINOS_STUDY_EXTERNAL=1
# Local quiet hours "start-end" (may wrap midnight); "0-0" disables.
LAINOS_STUDY_QUIET=23-9
# Hard cap of findings delivered per day.
LAINOS_STUDY_MAX_PER_DAY=3

# --- Trader (autonomous profit-taking) ---
# A background loop that sells journaled positions (data/trades.json keeps the
# moving-average cost basis) when their live Ritual quote clears the take-profit
# threshold. Positions without a recorded basis are never touched. Daemon-only
# by default; LAINOS_TRADER=1 forces it elsewhere, =0 disables it.
LAINOS_TRADER=
LAINOS_TRADER_INTERVAL_MS=900000
# Sell when unrealised gain vs cost basis reaches this (bps; 2500 = +25%).
LAINOS_TRADER_TAKE_PROFIT_BPS=2500
# Optional stop-loss (bps; 0 = off).
LAINOS_TRADER_STOP_LOSS_BPS=0
# Per-sale price-impact cap (bps). Oversized exits are halved until they fit.
LAINOS_TRADER_MAX_IMPACT_BPS=300
LAINOS_TRADER_SLIPPAGE_BPS=100
# Don't bother selling if proceeds would be below this many CYBER.
LAINOS_TRADER_MIN_PROCEEDS_CYBER=0.005

# --- Self-restart after self-upgrade ---
# When the forge successfully commits to the repo this daemon runs from, the
# daemon exits (code 75) so systemd revives it into the new code
# (ExecStartPre rebuilds dist/). Set 0 to keep running the old code instead.
LAINOS_FORGE_RESTART=1
