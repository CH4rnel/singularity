# LainOS environment. Copy to .env and fill in. Never commit .env.

# --- Model provider ---
# Provider selection order:
#   1. LAINOS_MODEL_PROVIDER (openrouter | anthropic | mock), if set
#   2. OPENROUTER_API_KEY present -> openrouter
#   3. ANTHROPIC_API_KEY present  -> anthropic
#   4. otherwise                  -> offline mock
# Leave this blank to auto-select by which key is present.
LAINOS_MODEL_PROVIDER=

# --- OpenRouter (one key, many models; OpenAI-compatible) ---
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# `openrouter/free` is OpenRouter's $0 "Free Models Router": it auto-routes to an
# available free model and keeps tool calling working (needed for Lain's on-chain
# actions). One slug, no rate-limit babysitting; quality varies per request.
OPENROUTER_MODEL_SMALL=openrouter/free
OPENROUTER_MODEL_MEDIUM=openrouter/free
OPENROUTER_MODEL_LARGE=openrouter/free
# To pin a specific free model instead:
#   OPENROUTER_MODEL_LARGE=openai/gpt-oss-120b:free
# For best quality (paid), use Claude:
#   OPENROUTER_MODEL_LARGE=anthropic/claude-opus-4.8
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_REFERER=https://cyberia.church
# OPENROUTER_TITLE=LainOS

# --- Anthropic (direct) ---
# Without any key, LainOS falls back to a deterministic mock model so the
# runtime loop is still demonstrable offline.
ANTHROPIC_API_KEY=
LAINOS_MODEL_SMALL=claude-haiku-4-5-20251001
LAINOS_MODEL_MEDIUM=claude-sonnet-4-6
LAINOS_MODEL_LARGE=claude-opus-4-8

# --- Cyberia chain plugin (defaults are Cyberia mainnet) ---
CYBERIA_RPC_URL=https://rpc.cyberia.church
CYBERIA_CHAIN_ID=49406
# Optional: a 0x private key enables the `send_cyber` / token-transfer actions.
# Leave empty for read-only mode. Never commit a real key.
CYBERIA_AGENT_PK=

# --- HTTP client (used by the Wired game's NPCs) ---
LAINOS_HTTP_HOST=127.0.0.1
LAINOS_HTTP_PORT=7777

# --- Wired game-auth server (model B: signs WiredForge entry tickets) ---
# Tickets are signed with CYBERIA_AGENT_PK (above). Its address MUST equal
# WiredForge.signer() on-chain (currently the deployer 0xfA41…5179) — otherwise
# the contract rejects the tickets. Change it with setSigner() if you use a
# dedicated signer key here.
WIRED_FORGE_ADDRESS=0x2daa4A79EC2224AD02D9D4eBf937924b76F669Fa
WIRED_CHAIN_ID=49406
WIRED_HTTP_PORT=7788

# Where long-term memory is persisted (memory.json: conversation + durable facts).
LAINOS_DATA_DIR=./data

# --- Semantic memory (optional) ---
# By default memory retrieval is keyword + recency. Wire up an embedding model
# to retrieve by *meaning* instead (cosine similarity). Vectors are cached in
# data/embeddings.json. Selection order:
#   1. LAINOS_EMBED_PROVIDER (openai | hash | none), if set
#   2. LAINOS_EMBED_API_KEY / OPENAI_API_KEY, or LAINOS_EMBED_BASE_URL present
#      -> OpenAI-compatible /embeddings endpoint (true semantic recall)
#   3. otherwise -> keyword retrieval (no embeddings, no network)
# `hash` is a zero-config, offline, dependency-free fallback: lexical vectors,
# not real semantics, but the same code path (so adding a key later just works).
LAINOS_EMBED_PROVIDER=
# OpenAI-compatible endpoint. Leave the API key blank for a local server that
# needs no auth. Examples:
#   OpenAI : LAINOS_EMBED_API_KEY=sk-...      LAINOS_EMBED_MODEL=text-embedding-3-small
#   Ollama : LAINOS_EMBED_BASE_URL=http://localhost:11434/v1  LAINOS_EMBED_MODEL=nomic-embed-text
LAINOS_EMBED_API_KEY=
# LAINOS_EMBED_BASE_URL=https://api.openai.com/v1
# LAINOS_EMBED_MODEL=text-embedding-3-small
# Optional: shrink vectors (OpenAI v3 models) / set the hash embedder's size.
# LAINOS_EMBED_DIMENSIONS=512
# NOTE: stored vectors are only comparable within one model. If you change
# LAINOS_EMBED_MODEL, delete data/embeddings.json so they get re-embedded.

# --- System plugin (terminal + filesystem skills) ---
# Loaded only for characters that request the "system" plugin. Gives the agent
# run_shell / read_file / write_file / list_dir, all confined to the workspace
# below. This is a powerful, dual-use capability — scope LAINOS_WORKSPACE to a
# directory you are comfortable letting the agent read and modify.
LAINOS_WORKSPACE=./workspace
# Hard timeout for a single shell command, in milliseconds.
LAINOS_SHELL_TIMEOUT_MS=30000
