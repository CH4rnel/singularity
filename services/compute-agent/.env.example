# CyberiaCompute contract on Cyberia (49406).
COMPUTE_ADDRESS=
COMPUTE_RPC_URL=https://rpc.cyberia.church
# The provider's key: registered and bonded on the contract. Pays gas for
# reportUsage/settle/withdraw, so it needs a little CYBER.
COMPUTE_PROVIDER_KEY=
# 1 only on a provider the DAO approved to run trusted-tier (secret-holding)
# services; their secrets are then read from this same environment by name.
COMPUTE_TRUSTED=0
COMPUTE_IPFS_GATEWAY=https://ipfs.io/ipfs/
COMPUTE_TICK_SECONDS=30
COMPUTE_REPORT_SECONDS=3600
COMPUTE_WITHDRAW_MIN_WEI=100000000000000000
# COMPUTE_DRY_RUN=1 with COMPUTE_PROVIDER_ADDRESS=0x… prints what would run.
